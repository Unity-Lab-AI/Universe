# ── Giants and supergiants ──

@star red-giant
name: Red giant
surface-kind: giant
real: yes
color: red-orange
stage: late life of a Sun-like star
tags: swollen, cool surface
radius-sol: 10..100
temp-k: 3300..5000
share-of-stars: uncommon

@star red-supergiant
name: Red supergiant
surface-kind: giant
real: yes
color: red
stage: late life of a heavy star
example: Betelgeuse
death: supernova
tags: huge, cool surface
radius-sol: 200..1500
temp-k: 3400..4100
share-of-stars: rarest

@star blue-supergiant
name: Blue supergiant
surface-kind: giant
real: yes
color: blue
example: Rigel
death: supernova
tags: huge, very bright
radius-sol: 20..100
temp-k: 10000..50000
share-of-stars: rarest

@star wolf-rayet
name: Wolf-Rayet star
surface-kind: normal
real: yes
color: blue
stage: heavy star blowing off its outer layers
tags: very hot, strong winds
radius-sol: 1..20
temp-k: 30000..200000
share-of-stars: rarest

# ── Young and failed stars ──

@star protostar
name: Protostar
surface-kind: normal
real: yes
stage: a star still forming inside a gas cloud
tags: young, hidden in dust
radius-sol: 2..10
temp-k: 2000..4000
share-of-stars: rare

@star t-tauri
name: T Tauri star
surface-kind: normal
spots: yes
real: yes
stage: a young Sun-like star, not yet steady
tags: young, flaring, variable
radius-sol: 1.5..3
temp-k: 3000..5000
share-of-stars: rare

@star brown-dwarf
name: Brown dwarf
surface-kind: brown-dwarf
real: yes
