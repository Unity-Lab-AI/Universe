# DNA-AND content · a quick test descent from a galaxy to the ground and on to the atoms (no story), for checking each scale

@stop g
do: pick
target: galaxy
caption: g

@stop tg
do: zoom
rate: 1.2
until-km: 3e16
caption: tg

@stop s
do: pick
target: star
caption: s

@stop ts
do: zoom
rate: 1.2
until-km: 3e9
caption: ts

@stop p
do: pick
target: planet
caption: p

@stop tp
do: zoom
rate: 1
until-km: 2e4
caption: tp

@stop land
do: zoom
rate: 0.6
until-km: 0.01
caption: land

@stop n
do: pick
target: none
caption: n

@stop up
do: look
tilt: 55
turn: 1
seconds: 6
caption: up

@stop sky
do: orbit
turn: 3
seconds: 6
caption: sky

@stop down
do: look
tilt: -85
turn: 1
seconds: 5
caption: down

@stop grains
do: zoom
rate: 0.25
until-km: 1e-9
caption: grains

@stop atoms
do: zoom
rate: 0.25
until-km: 5e-13
caption: atoms

@stop atom
do: pick
target: atom
caption: atom

@stop to-atom
do: zoom
rate: 0.3
until-km: 3e-13
caption: to-atom

@stop el
do: pick
target: electron
caption: el

@stop round-el
do: orbit
turn: 3
seconds: 12
caption: round-el

@stop end
do: orbit
turn: 2
seconds: 10
caption: end

